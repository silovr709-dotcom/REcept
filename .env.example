# Скопируйте этот файл в .env.local и заполните реальными значениями.
# .env.local не попадает в git.

# Домен сайта. Влияет на canonical-ссылки, sitemap.xml и Open Graph.
NEXT_PUBLIC_SITE_URL=https://recept-tver.ru

# --- Куда приходят заявки с форм ---
# Пока эти переменные не заданы, заявки сохраняются в .leads/leads.jsonl
# и пишутся в логи сервера — то есть не теряются.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

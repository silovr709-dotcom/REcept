# Скопируйте этот файл в .env.local и заполните реальными значениями.
# .env.local в git не попадает.

# Домен сайта. Влияет на canonical-ссылки, sitemap.xml и Open Graph.
# Кириллический домен пишется здесь в ASCII (punycode) — иначе ссылки
# ломаются. рецепт-тверь.рф = xn----dtbhac1degob3b6e.xn--p1ai
NEXT_PUBLIC_SITE_URL=https://xn----dtbhac1degob3b6e.xn--p1ai
# Как домен показывать человеку в тексте страниц.
NEXT_PUBLIC_SITE_DISPLAY=рецепт-тверь.рф

# --- Вход в админку (адрес /admin) ---
# ADMIN_PASSWORD — пароль, который вводят владельцы.
# AUTH_SECRET — случайная строка от 32 символов: ею подписывается вход.
# Сгенерировать секрет: openssl rand -hex 32
ADMIN_PASSWORD=
AUTH_SECRET=

# --- Куда приходят заявки с форм ---
# Пока эти переменные не заданы, заявки сохраняются в .leads/leads.jsonl
# и видны в админке в разделе «Заявки» — то есть не теряются.
# Для Яндекс Почты нужен пароль приложения, а не пароль от аккаунта.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# --- Дубль заявок в Telegram ---
# Независимый от почты канал: сообщение приходит в телефон за секунду.
# Токен берётся у @BotFather (/newbot), chat id — из
# https://api.telegram.org/bot<ТОКЕН>/getUpdates после любого сообщения боту.
# Пусто — канал просто выключен, на работу формы это не влияет.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Яндекс.Метрика ---
# Номер счётчика. Можно задать и через админку (раздел «Контакты»),
# но для статического сайта на хостинге надёжнее переменная окружения:
# статика собирается на сборочной машине, где админки нет.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

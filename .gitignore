# ---------------------------------------------------------------
# ДАННЫЕ, КОТОРЫМИ УПРАВЛЯЕТ АДМИНКА
# ---------------------------------------------------------------
# Это живые данные сайта, а не исходный код. Они меняются прямо
# на сервере, поэтому в git не хранятся — иначе каждое обновление
# кода конфликтовало бы с правками владельцев.
#
# Исходное наполнение лежит в src/lib/content/seed.ts: на чистом
# сервере сайт поднимется с ним и сам создаст эти файлы.
# Резервная копия скачивается из админки.
# Ведущий слэш обязателен: без него правило скрыло бы и src/lib/content
/content/
/public/uploads/

# Локальный журнал заявок (страховка на случай проблем с почтой)
/.leads/

.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
next-env.d.ts
.static-stash/

# Исходники от владельцев: эталонные фотографии для генерации сцен.
# Описание внешности (ОПИСАНИЕ.md) в репозитории нужно, а сами личные
# снимки в публичный репозиторий не кладём — они не должны попадать
# ни в историю git, ни на GitHub Pages.
/reference/team/*
!/reference/team/ОПИСАНИЕ.md
# Исключение, согласованное с владельцами: главный референс личностей.
# Песочница пересобирается между сессиями и стирает всё, чего нет в git,
# — а без исходника новый кадр с Робертом и Катей сделать нельзя.
# На сайт файл не попадает: он лежит вне public/ и в сборку не включён.
!/reference/team/rob-kate-main.jpg
!/reference/team/rob-face-main.jpg
!/reference/team/kate-face-main.jpg

# Сборка для собственного домена (готовится перед заливкой на хостинг)
/site/
/*.zip
